# Which backend to use: "openai" or "anthropic"
LLM_PROVIDER=anthropic

# --- Option A: Claude through the SharedLLM gateway (used for the committed logs) ---
ANTHROPIC_API_KEY=sk-sharedllm-REPLACE-ME
ANTHROPIC_BASE_URL=https://api.sharedllm.com/custom-anthropic
ANTHROPIC_EXTRA_HEADERS={"X-SharedLLM-Key": "sk-sharedllm-REPLACE-ME", "anthropic-version": "2023-06-01"}
ANTHROPIC_MODEL=claude-sonnet-5

# --- Option B: OpenAI directly (set LLM_PROVIDER=openai) ---
OPENAI_API_KEY=sk-REPLACE-ME
OPENAI_MODEL=gpt-4.1-mini
