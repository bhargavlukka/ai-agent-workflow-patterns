# Which backend to use: "openai" or "anthropic"
LLM_PROVIDER=anthropic

# --- Option A: SharedLLM gateway, Anthropic-compatible endpoint (used for the committed logs) ---
ANTHROPIC_API_KEY=sk-sharedllm-REPLACE-ME
ANTHROPIC_BASE_URL=https://api.sharedllm.com/custom-anthropic
ANTHROPIC_EXTRA_HEADERS={"X-SharedLLM-Key": "sk-sharedllm-REPLACE-ME", "anthropic-version": "2023-06-01"}
# gpt-oss:120b was used for the committed logs; use claude-sonnet-5 if your account has Claude access
ANTHROPIC_MODEL=gpt-oss:120b

# --- Option B: OpenAI directly (set LLM_PROVIDER=openai) ---
OPENAI_API_KEY=sk-REPLACE-ME
OPENAI_MODEL=gpt-4.1-mini
